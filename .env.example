# Hostinger Environment Variables (do not set PORT: Hostinger assigns it).
APP_ENV=production
NODE_ENV=production
APP_ORIGIN=https://YOUR-TEMPORARY-HOSTINGER-URL
JARVIS_INSTANCE=jarvis-test
# Optional absolute private path OUTSIDE public_html and hbuilds.
# Default: your hosting user's ~/.jarvis-data/jarvis-test/
JARVIS_DATA_DIR=
AUTH_SECRET=CHANGE_TO_UNIQUE_RANDOM_64_CHAR_SECRET
ENCRYPTION_KEY=CHANGE_TO_32_ASCII_CHARACTERS
ENCRYPTION_IV=CHANGE_TO_16_ASCII_CHARACTERS
SEED_DEMO_USER=true
DEMO_USER_NAME=Jarvis Test User
DEMO_USER_EMAIL=YOUR_EMAIL
DEMO_USER_PASSWORD=CHANGE_TO_UNIQUE_PASSWORD_16_PLUS_CHARACTERS
ALLOW_REGISTRATION=false
WATCHER_ENABLED=false
WATCHER_SYNC_GITHUB=false
WA_WORKER_ENABLED=true
SOCKET_TRANSPORTS=polling
TZ=Asia/Dubai
# Optional SMTP for password reset/email verification. WhatsApp does not use SMTP.
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
